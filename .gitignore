__pycache__/
*.py[cod]
.venv/
.uv/
dist/
build/
*.egg-info/
.ruff_cache/
.pytest_cache/
.mypy_cache/

# ── 前端 ──
node_modules/
frontend/dist/
frontend/.vite/
*.log

# ── 杂 ──
.DS_Store
.idea/
.vscode/

# TS 增量构建缓存
*.tsbuildinfo
